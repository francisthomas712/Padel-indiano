{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "SET-ME-test-key",
        "EXPO_PUBLIC_ENTITLEMENT_SERVER": "http://localhost:3010"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "SET-ME-appl-key",
        "EXPO_PUBLIC_ENTITLEMENT_SERVER": "https://padel-entitlement.ottercycle.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
